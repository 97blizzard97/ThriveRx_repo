# Copy to .env and adjust for local dev
DATABASE_URL=sqlite:///./thriverx.db
CORS_ORIGINS=*

# Optional — enables real vision OCR for POST /api/v1/scan/script (backend only).
# Prefer Google AI Studio (Gemini). Without a key, type a short hint instead.
# GOOGLE_API_KEY=
# GOOGLE_VISION_MODEL=gemini-3.1-flash-lite
# Optional OpenAI fallback:
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
